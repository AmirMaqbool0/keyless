# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
# Local dev DB started by `pnpm dev` (or Docker). Free hosted option: MongoDB Atlas M0.
MONGO_URI=mongodb://127.0.0.1:27017/keyless?directConnection=true
# Needed from M3 (queues). Free hosted option: Upstash Redis.
REDIS_URL=redis://127.0.0.1:6379

# --- Storage. STORAGE_DRIVER=local writes to STORAGE_LOCAL_DIR; s3 (S3/R2/MinIO) arrives in M3 ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/files
S3_ENDPOINT=
S3_REGION=eu-west-2
S3_BUCKET=keyless
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Security --- (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_KEY=
JWT_SECRET=

# --- LLM (from M4). LLM_PROVIDER=mock runs fully offline ---
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL_EXTRACTION=
LLM_MODEL_CLASSIFY=

# --- Mailboxes (from M3) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INBOUND_EMAIL_DOMAIN=in.keyless.local
INBOUND_WEBHOOK_SECRET=

# --- Outbound email. EMAIL_PROVIDER=console logs emails and shows them at /dev/emails ---
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Keyless <no-reply@keyless.local>

# --- Billing (from M9; use Stripe test mode keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info
