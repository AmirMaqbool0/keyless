{
  "name": "keyless",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n db,api,worker,web -c gray,blue,yellow,magenta \"pnpm dev:db\" \"pnpm --filter @keyless/api dev\" \"pnpm --filter @keyless/worker dev\" \"pnpm --filter @keyless/web dev\"",
    "dev:db": "node scripts/dev-db.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "seed": "pnpm --filter @keyless/api seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
